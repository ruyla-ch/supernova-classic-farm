# Copy to .env for local overrides. These values are for local development only.
# Never commit a real .env file. Fill MYSQL_PASSWORD locally; do not put secrets here.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=classicfarm
MYSQL_USER=classicfarm
MYSQL_PASSWORD=请在本地填写
# Docker Compose only. Use a different local-development password from MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=请在本地填写另一个密码
# Optional: construct yourself for ad-hoc shells. Prefer the fields above for the test runner.
# MYSQL_DSN=

TZ=Asia/Shanghai
